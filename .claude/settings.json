{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -NonInteractive -File \".claude\\hooks\\clang-format-check.ps1\"",
                        "timeout": 30,
                        "statusMessage": "Checking clang-format..."
                    }
                ]
            }
        ]
    }
}
